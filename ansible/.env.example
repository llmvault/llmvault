# Copy to ansible/.env and fill before running phase3-deploy.yml.
# This file uses shell-style KEY=value lines.

HIVY_MICROSANDBOX_CONTROL_URL=https://your-railway-control.example.com
HIVY_MICROSANDBOX_RUNNER_JOIN_SECRET=
HIVY_MICROSANDBOX_RUNNER_API_TOKEN=

# Used by the Caddy VPS route-cache service. The Railway control plane uses
# this token to push route cache upserts/deletes.
HIVY_MICROSANDBOX_PREVIEW_CACHE_TOKEN=
HIVY_MICROSANDBOX_PREVIEW_BASE_DOMAIN=preview.usehivy.com
VERCEL_AUTH_API_TOKEN=

HIVY_MICROSANDBOX_SNAPSHOT_S3_BUCKET=
HIVY_MICROSANDBOX_SNAPSHOT_S3_REGION=auto
HIVY_MICROSANDBOX_SNAPSHOT_S3_ENDPOINT=
HIVY_MICROSANDBOX_SNAPSHOT_S3_ACCESS_KEY_ID=
HIVY_MICROSANDBOX_SNAPSHOT_S3_SECRET_ACCESS_KEY=

# Optional.
HIVY_MICROSANDBOX_SNAPSHOT_S3_PREFIX=snapshots
HIVY_MICROSANDBOX_SNAPSHOT_S3_PATH_STYLE=true
HIVY_MICROSANDBOX_SENTRY_DSN=
