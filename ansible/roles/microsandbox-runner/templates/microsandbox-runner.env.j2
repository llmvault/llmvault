HIVY_MICROSANDBOX_RUNNER_NAME={{ runner_name }}
HIVY_MICROSANDBOX_RUNNER_PUBLIC_URL={{ runner_public_url }}
HIVY_MICROSANDBOX_RUNNER_PREVIEW_BASE_URL={{ runner_preview_base_url }}
HIVY_MICROSANDBOX_RUNNER_BACKEND={{ microsandbox_runner_backend }}
HIVY_MICROSANDBOX_RUNNER_TOTAL_CPU={{ microsandbox_runner_total_cpu }}
HIVY_MICROSANDBOX_RUNNER_TOTAL_MEMORY_MB={{ microsandbox_runner_total_memory_mb }}
HIVY_MICROSANDBOX_RUNNER_TOTAL_DISK_GB={{ microsandbox_runner_total_disk_gb }}
HIVY_MICROSANDBOX_RUNNER_CPU_OVERCOMMIT={{ runner_cpu_overcommit }}
