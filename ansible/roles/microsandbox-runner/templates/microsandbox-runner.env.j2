HIVY_MICROSANDBOX_RUNNER_PREVIEW_PORT_RANGE_END={{ runner_preview_port_range_end }}
HIVY_MICROSANDBOX_IMAGE_REGISTRY={{ microsandbox_env.HIVY_MICROSANDBOX_IMAGE_REGISTRY | default('10.80.0.3:5000') }}
HIVY_MICROSANDBOX_SNAPSHOT_S3_BUCKET={{ microsandbox_env.HIVY_MICROSANDBOX_SNAPSHOT_S3_BUCKET }}
HIVY_MICROSANDBOX_SNAPSHOT_S3_REGION={{ microsandbox_env.HIVY_MICROSANDBOX_SNAPSHOT_S3_REGION }}
HIVY_MICROSANDBOX_SNAPSHOT_S3_ENDPOINT={{ microsandbox_env.HIVY_MICROSANDBOX_SNAPSHOT_S3_ENDPOINT }}
HIVY_MICROSANDBOX_SNAPSHOT_S3_ACCESS_KEY_ID={{ microsandbox_env.HIVY_MICROSANDBOX_SNAPSHOT_S3_ACCESS_KEY_ID }}
HIVY_MICROSANDBOX_SNAPSHOT_S3_SECRET_ACCESS_KEY={{ microsandbox_env.HIVY_MICROSANDBOX_SNAPSHOT_S3_SECRET_ACCESS_KEY }}
HIVY_MICROSANDBOX_SNAPSHOT_S3_PREFIX={{ microsandbox_env.HIVY_MICROSANDBOX_SNAPSHOT_S3_PREFIX | default('snapshots') }}
HIVY_MICROSANDBOX_SNAPSHOT_S3_PATH_STYLE={{ microsandbox_env.HIVY_MICROSANDBOX_SNAPSHOT_S3_PATH_STYLE | default('true') }}
{% if microsandbox_env.HIVY_MICROSANDBOX_SENTRY_DSN is defined and microsandbox_env.HIVY_MICROSANDBOX_SENTRY_DSN | trim | length > 0 %}
HIVY_MICROSANDBOX_SENTRY_DSN={{ microsandbox_env.HIVY_MICROSANDBOX_SENTRY_DSN }}
{% endif %}
