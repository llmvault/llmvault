HIVY_MICROSANDBOX_ENVIRONMENT=production
HIVY_MICROSANDBOX_ADDR={{ microsandbox_runner_addr }}
HIVY_MICROSANDBOX_CONTROL_URL={{ microsandbox_env.HIVY_MICROSANDBOX_CONTROL_URL }}
HIVY_MICROSANDBOX_RUNNER_JOIN_SECRET={{ microsandbox_env.HIVY_MICROSANDBOX_RUNNER_JOIN_SECRET }}
HIVY_MICROSANDBOX_RUNNER_API_TOKEN={{ microsandbox_env.HIVY_MICROSANDBOX_RUNNER_API_TOKEN }}
HIVY_MICROSANDBOX_RUNNER_NAME={{ runner_name }}
HIVY_MICROSANDBOX_RUNNER_PUBLIC_URL={{ runner_public_url }}
HIVY_MICROSANDBOX_RUNNER_PREVIEW_BASE_URL={{ runner_preview_base_url }}
HIVY_MICROSANDBOX_RUNNER_BACKEND={{ microsandbox_runner_backend }}
HIVY_MICROSANDBOX_RUNNER_TOTAL_CPU={{ microsandbox_runner_total_cpu }}
HIVY_MICROSANDBOX_RUNNER_TOTAL_MEMORY_MB={{ microsandbox_runner_total_memory_mb }}
HIVY_MICROSANDBOX_RUNNER_TOTAL_DISK_GB={{ microsandbox_runner_total_disk_gb }}
HIVY_MICROSANDBOX_RUNNER_CPU_OVERCOMMIT={{ runner_cpu_overcommit }}
HIVY_MICROSANDBOX_RUNNER_MEMORY_OVERCOMMIT={{ runner_memory_overcommit }}
HIVY_MICROSANDBOX_RUNNER_DISK_OVERCOMMIT={{ runner_disk_overcommit }}
HIVY_MICROSANDBOX_RUNNER_PREVIEW_PORT_RANGE_START={{ runner_preview_port_range_start }}
HIVY_MICROSANDBOX_RUNNER_PREVIEW_PORT_RANGE_END={{ runner_preview_port_range_end }}
HIVY_MICROSANDBOX_RUNNER_DNS_NAMESERVER={{ runner_private_ip }}:53
HIVY_MICROSANDBOX_RUNNER_PRIVATE_EGRESS_CIDR={{ runner_sandbox_private_egress_cidr }}
HIVY_MICROSANDBOX_RUNNER_PRIVATE_EGRESS_PORTS={{ runner_sandbox_private_egress_ports }}
HIVY_MICROSANDBOX_IMAGE_REGISTRY={{ microsandbox_env.HIVY_MICROSANDBOX_IMAGE_REGISTRY | default('10.80.0.3:5000') }}
{% if microsandbox_env.HIVY_MICROSANDBOX_SENTRY_DSN is defined and microsandbox_env.HIVY_MICROSANDBOX_SENTRY_DSN | trim | length > 0 %}
HIVY_MICROSANDBOX_SENTRY_DSN={{ microsandbox_env.HIVY_MICROSANDBOX_SENTRY_DSN }}
{% endif %}
