# Managed by Ansible. Cluster-wide values must remain identical on every K3s
# server node. Only the first inventory host initializes embedded etcd.
{% if inventory_hostname == k3s_bootstrap_host %}
cluster-init: true
{% else %}
server: {{ k3s_bootstrap_server_url }}
{% endif %}
token-file: /etc/rancher/k3s/server-token

node-name: {{ k3s_node_name }}
node-ip: {{ k3s_node_ip }}
advertise-address: {{ k3s_node_ip }}
bind-address: {{ k3s_bind_address }}
tls-san:
{% for server_host in groups['k3s_servers'] %}
  - {{ hostvars[server_host].k3s_node_ip }}
{% endfor %}

cluster-cidr: {{ k3s_cluster_cidr }}
service-cidr: {{ k3s_service_cidr }}

flannel-backend: none
disable-network-policy: true
disable-kube-proxy: true

disable:
  - traefik
  - servicelb
  - local-storage

secrets-encryption: true
write-kubeconfig-mode: "0600"

etcd-snapshot-schedule-cron: "{{ k3s_etcd_snapshot_schedule }}"
etcd-snapshot-retention: {{ k3s_etcd_snapshot_retention }}
{% if k3s_etcd_s3_enabled | bool %}
etcd-s3: true
etcd-s3-config-secret: {{ k3s_etcd_s3_config_secret }}
{% endif %}

{% if inventory_hostname in (groups['k3s_ingress'] | default([])) %}
node-label:
  - "hivy.io/public-ingress=true"
{% endif %}

kubelet-arg:
  - "system-reserved={{ k3s_system_reserved }}"
  - "kube-reserved={{ k3s_kube_reserved }}"
  - "eviction-hard=memory.available<2Gi,nodefs.available<10%,imagefs.available<15%"
