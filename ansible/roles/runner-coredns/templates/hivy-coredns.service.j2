[Unit]
Description=Hivy private split-horizon DNS
Documentation=https://coredns.io/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coredns
Group=coredns
ExecStart={{ runner_coredns_install_dir }}/coredns -conf {{ runner_coredns_config_dir }}/Corefile
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ runner_coredns_config_dir }}

[Install]
WantedBy=multi-user.target
