[Unit]
Description=Hivy runner VictoriaLogs agent
Documentation=https://docs.victoriametrics.com/victorialogs/vlagent/
After=network-online.target haproxy.service
Wants=network-online.target

[Service]
Type=simple
User={{ runner_observability_user }}
Group={{ runner_observability_group }}
ExecStart=/usr/local/bin/vlagent \
  -httpListenAddr={{ runner_vlagent_listen_addr }} \
  -remoteWrite.url=https://{{ runner_telemetry_hostname }}/insert/native \
  -remoteWrite.bearerTokenFile={{ runner_telemetry_token_path }} \
  -remoteWrite.tmpDataPath=/var/lib/hivy-vlagent \
  -remoteWrite.maxDiskUsagePerURL={{ runner_vlagent_buffer_size }} \
  -remoteWrite.showURL=false
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hivy-vlagent
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
