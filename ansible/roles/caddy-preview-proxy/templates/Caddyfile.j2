{
	email {{ caddy_preview_proxy_acme_email }}
}

{{ caddy_preview_proxy_domain }}, *.{{ caddy_preview_proxy_domain }} {
	tls {
		dns vercel {env.VERCEL_AUTH_API_TOKEN}
	}

	log {
		output stdout
		format json
	}

	handle /health {
		respond "{{ caddy_preview_proxy_health_body | trim }}" 200
	}

	handle_path /_microsandbox/preview-cache/* {
		reverse_proxy 127.0.0.1:8091
	}

	handle {
		forward_auth http://127.0.0.1:8091 {
			uri /v1/lookup
			header_up -Authorization
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Uri {uri}
			copy_headers {
				X-Microsandbox-Upstream
				X-Microsandbox-Sandbox-Id
				X-Microsandbox-Guest-Port
				X-Microsandbox-Route-Generation
			}
			transport http {
				response_header_timeout {{ caddy_preview_proxy_forward_auth_timeout }}
			}
		}

		reverse_proxy {http.request.header.X-Microsandbox-Upstream} {
			header_up X-Hivy-Preview-Host {host}
			header_up -X-Microsandbox-*
			flush_interval -1
			transport http {
				response_header_timeout 60s
			}
		}
	}

	# reverse_proxy dial failures enter the error route. Report the exact failed
	# generation to the local cache, then let the client retry through the normal
	# single-flight wake path. The original request is never replayed.
	handle_errors 502 {
		reverse_proxy 127.0.0.1:8091 {
			method GET
			rewrite /v1/routes/invalidate
			header_up Authorization "Bearer {env.HIVY_MICROSANDBOX_PREVIEW_CACHE_TOKEN}"
			header_up X-Microsandbox-Upstream {http.request.header.X-Microsandbox-Upstream}
			header_up X-Microsandbox-Sandbox-Id {http.request.header.X-Microsandbox-Sandbox-Id}
			header_up X-Microsandbox-Guest-Port {http.request.header.X-Microsandbox-Guest-Port}
			header_up X-Microsandbox-Route-Generation {http.request.header.X-Microsandbox-Route-Generation}
			header_down Retry-After 1
			replace_status 503
		}
	}
}
