HIVY_MICROSANDBOX_PREVIEW_CACHE_TOKEN={{ microsandbox_preview_cache_env.HIVY_MICROSANDBOX_PREVIEW_CACHE_TOKEN }}
HIVY_MICROSANDBOX_RUNNER_API_TOKEN={{ microsandbox_preview_cache_env.HIVY_MICROSANDBOX_RUNNER_API_TOKEN }}
HIVY_MICROSANDBOX_PREVIEW_BASE_DOMAIN={{ microsandbox_preview_cache_env.HIVY_MICROSANDBOX_PREVIEW_BASE_DOMAIN | default('preview.usehivy.com') }}
{% if microsandbox_preview_cache_env.HIVY_PREVIEW_ACTIVITY_API_URL is defined %}
HIVY_PREVIEW_ACTIVITY_API_URL={{ microsandbox_preview_cache_env.HIVY_PREVIEW_ACTIVITY_API_URL }}
{% endif %}
{% if microsandbox_preview_cache_env.HIVY_PREVIEW_ACTIVITY_TOKEN is defined %}
HIVY_PREVIEW_ACTIVITY_TOKEN={{ microsandbox_preview_cache_env.HIVY_PREVIEW_ACTIVITY_TOKEN }}
