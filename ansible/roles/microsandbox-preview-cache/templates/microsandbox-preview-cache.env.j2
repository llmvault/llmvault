HIVY_MICROSANDBOX_PREVIEW_CACHE_ADDR={{ microsandbox_preview_cache_addr }}
HIVY_MICROSANDBOX_PREVIEW_CACHE_PORT={{ microsandbox_preview_cache_port }}
