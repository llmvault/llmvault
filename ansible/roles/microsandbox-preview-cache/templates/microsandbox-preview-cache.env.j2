HIVY_MICROSANDBOX_CONTROL_URL={{ microsandbox_preview_cache_env.HIVY_MICROSANDBOX_CONTROL_URL }}
{% endif %}
{% if microsandbox_preview_cache_env.HIVY_MICROSANDBOX_PREVIEW_WAKE_TOKEN is defined %}
HIVY_MICROSANDBOX_PREVIEW_WAKE_TOKEN={{ microsandbox_preview_cache_env.HIVY_MICROSANDBOX_PREVIEW_WAKE_TOKEN }}
{% endif %}
HIVY_MICROSANDBOX_PREVIEW_WAKE_TIMEOUT={{ microsandbox_preview_cache_env.HIVY_MICROSANDBOX_PREVIEW_WAKE_TIMEOUT | default('55s') }}
{% if microsandbox_preview_cache_env.VERCEL_AUTH_API_TOKEN is defined and microsandbox_preview_cache_env.VERCEL_AUTH_API_TOKEN | trim | length > 0 %}
