#!/usr/bin/env python3
import json
import os
import re
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

import redis


ADDR = os.environ.get("HIVY_MICROSANDBOX_PREVIEW_CACHE_ADDR", "127.0.0.1")
PORT = int(os.environ.get("HIVY_MICROSANDBOX_PREVIEW_CACHE_PORT", "8091"))
REDIS_URL = os.environ.get("HIVY_MICROSANDBOX_PREVIEW_CACHE_REDIS_URL", "redis://127.0.0.1:6379/0")
TOKEN = os.environ.get("HIVY_MICROSANDBOX_PREVIEW_CACHE_TOKEN", "")
BASE_DOMAIN = os.environ.get("HIVY_MICROSANDBOX_PREVIEW_BASE_DOMAIN", "preview.usehivy.com").strip(".")
KEY_PREFIX = "microsandbox:preview-route:"

client = redis.Redis.from_url(REDIS_URL, decode_responses=True)


def key_for(sandbox_id):
    return KEY_PREFIX + sandbox_id


def response(handler, status, payload=None, headers=None):
    body = b""
    if payload is not None:
        body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    handler.send_response(status)
    handler.send_header("Content-Type", "application/json" if payload is not None else "text/plain")
    handler.send_header("Content-Length", str(len(body)))
    if headers:
        for name, value in headers.items():
            handler.send_header(name, value)
    handler.end_headers()
    if body:
        handler.wfile.write(body)


def read_json(handler):
    length = int(handler.headers.get("Content-Length") or "0")
    if length <= 0:
        return {}
    return json.loads(handler.rfile.read(length).decode("utf-8"))


def bearer(handler):
    auth = handler.headers.get("Authorization", "")
    if not auth.startswith("Bearer "):
        return ""
    return auth[len("Bearer "):]


def require_token(handler):
    if not TOKEN or bearer(handler) != TOKEN:
        response(handler, 401, {"error": "unauthorized"})
        return False
    return True


def normalize_route(raw, sandbox_id=None):
    route = dict(raw)
    if sandbox_id:
        route["sandbox_id"] = sandbox_id
    sid = str(route.get("sandbox_id", "")).strip()
    if not sid:
        raise ValueError("sandbox_id is required")
    upstreams = route.get("upstreams") or {}
    normalized_upstreams = {}
    for guest_port, upstream in upstreams.items():
        key = str(int(guest_port))
        value = str(upstream).strip().rstrip("/")
        if not value:
            continue
        if not value.startswith("http://") and not value.startswith("https://"):
            value = "http://" + value
        normalized_upstreams[key] = value
    if not normalized_upstreams:
        raise ValueError("upstreams is required")
    route["sandbox_id"] = sid
    route["upstreams"] = normalized_upstreams
    route["status"] = str(route.get("status") or "running")
    route["updated_at"] = int(time.time())
    return route


def store_route(route):
    ttl = int(route.get("ttl_seconds") or 0)
    payload = json.dumps(route, separators=(",", ":"))
    if ttl > 0:
        client.set(key_for(route["sandbox_id"]), payload, ex=ttl)
    else:
        client.set(key_for(route["sandbox_id"]), payload)


def parse_preview_host(host):
    host = host.split(":", 1)[0].strip(".").lower()
    suffix = "." + BASE_DOMAIN.lower()
    if not host.endswith(suffix):
        return None, None
    first_label = host[: -len(suffix)].split(".")[-1]
    match = re.match(r"^([0-9]{1,5})-(.+)$", first_label)
    if not match:
        return None, None
    port = int(match.group(1))
    if port <= 0 or port > 65535:
        return None, None
    return port, match.group(2)


class Handler(BaseHTTPRequestHandler):
    server_version = "hivy-preview-cache/1"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/health":
            try:
                client.ping()
            except Exception as exc:
                response(self, 503, {"status": "error", "error": str(exc)})
                return
            response(self, 200, {"status": "ok"})
            return

        if parsed.path == "/v1/lookup":
            host = self.headers.get("X-Forwarded-Host") or self.headers.get("Host") or ""
            original_uri = self.headers.get("X-Forwarded-Uri") or "/"
            port, sandbox_id = parse_preview_host(host)
            if not sandbox_id:
                response(self, 404, {"error": "invalid preview host"})
                return
            raw = client.get(key_for(sandbox_id))
            if not raw:
                response(self, 404, {"error": "route not found"})
                return
            route = json.loads(raw)
            if route.get("status") not in ("running", "ready", ""):
                response(self, 503, {"error": "sandbox is not running"})
                return
            upstream = (route.get("upstreams") or {}).get(str(port))
            if not upstream:
                response(self, 404, {"error": "port not previewable"})
                return
            rewrite = original_uri if original_uri.startswith("/") else "/" + original_uri
            self.send_response(204)
            self.send_header("X-Microsandbox-Upstream", upstream)
            self.send_header("X-Microsandbox-Rewrite-URI", rewrite)
            self.end_headers()
            return

        match = re.match(r"^/v1/routes/([^/]+)$", parsed.path)
        if match:
            if not require_token(self):
                return
            raw = client.get(key_for(match.group(1)))
            if not raw:
                response(self, 404, {"error": "route not found"})
                return
            response(self, 200, json.loads(raw))
            return

        response(self, 404, {"error": "not found"})

    def do_POST(self):
        self.write_route()

    def do_PUT(self):
        self.write_route()

    def write_route(self):
        parsed = urlparse(self.path)
        if not require_token(self):
            return
        try:
            body = read_json(self)
            if parsed.path == "/v1/routes/bulk":
                routes = [normalize_route(item) for item in body.get("routes", [])]
                for route in routes:
                    store_route(route)
                response(self, 200, {"stored": len(routes)})
                return
            match = re.match(r"^/v1/routes/([^/]+)$", parsed.path)
            if match:
                route = normalize_route(body, match.group(1))
                store_route(route)
                response(self, 200, route)
                return
            response(self, 404, {"error": "not found"})
        except Exception as exc:
            response(self, 400, {"error": str(exc)})

    def do_DELETE(self):
        parsed = urlparse(self.path)
        if not require_token(self):
            return
        match = re.match(r"^/v1/routes/([^/]+)$", parsed.path)
        if not match:
            response(self, 404, {"error": "not found"})
            return
        deleted = client.delete(key_for(match.group(1)))
        response(self, 200, {"deleted": bool(deleted)})


if __name__ == "__main__":
    if not TOKEN:
        raise SystemExit("HIVY_MICROSANDBOX_PREVIEW_CACHE_TOKEN is required")
    client.ping()
    ThreadingHTTPServer((ADDR, PORT), Handler).serve_forever()
