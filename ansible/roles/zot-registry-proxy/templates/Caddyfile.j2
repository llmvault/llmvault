{
	email {{ zot_registry_caddy_acme_email | default('ops@usehivy.com') }}
}

{{ zot_registry_domain }}:{{ zot_registry_tls_port }} {
	bind {{ zot_registry_private_ip }}

	tls {
		dns vercel {env.VERCEL_AUTH_API_TOKEN}
	}

	reverse_proxy {{ zot_registry_upstream_addr }}:{{ zot_registry_upstream_port }}
}
