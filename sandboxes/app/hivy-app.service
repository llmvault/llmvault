[Unit]
Description=Hivy app server
After=network.target hivy-appd.service
# Not-yet-deployed sandboxes skip this unit cleanly (a condition failure is
# not a unit failure); the first appd /deploy restarts it into existence.
ConditionPathExists=/workspace/app/current/server

[Service]
WorkingDirectory=/workspace/app/current
# /workspace/app/env intentionally carries no PORT: the server defaults to
# 8080 (hivycore/config.go), and the sandbox alias/proxy the platform points
# at this app is hard-bound to 8080 (internal/apps/image.go's appPort). Do
# not add PORT to that env file or change this default — it would only make
# the deployed app unreachable behind its own alias.
EnvironmentFile=-/workspace/app/env
ExecStartPre=/bin/mkdir -p /workspace/logs
ExecStart=/workspace/app/current/server
StandardOutput=append:/workspace/logs/app.log
StandardError=append:/workspace/logs/app.log
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
