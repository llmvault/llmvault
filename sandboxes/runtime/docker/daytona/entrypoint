#!/bin/sh
set -eu

HIVY_SANDBOX_DATA_ROOT="${HIVY_SANDBOX_DATA_ROOT:-${HOME}/.hivy}"
TMPDIR="${TMPDIR:-${HIVY_SANDBOX_DATA_ROOT}/tmp}"
export HIVY_SANDBOX_DATA_ROOT TMPDIR

mkdir -p \
  "${HIVY_SANDBOX_DATA_ROOT}/runtime" \
  "${HIVY_SANDBOX_DATA_ROOT}/logs" \
  "${TMPDIR}" \
  "${HIVY_WORKSPACE_ROOT:-${HOME}}/repos" \
  "${HIVY_WORKSPACE_ROOT:-${HOME}}/canvas"

if [ -n "${HIVY_GIT_USERNAME:-}" ]; then
  git config --global user.name "${HIVY_GIT_USERNAME}"
fi
if [ -n "${HIVY_GIT_EMAIL:-}" ]; then
  git config --global user.email "${HIVY_GIT_EMAIL}"
fi
git config --global credential.helper /usr/local/bin/git-credential-hivy

if [ "${HIVY_DAYTONA_START_DOCKER:-0}" = "1" ]; then
  /usr/local/bin/hivy-start-docker
fi

exec /usr/local/bin/hivy-sandboxes-runtime
