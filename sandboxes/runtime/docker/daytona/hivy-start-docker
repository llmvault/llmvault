#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  exec sudo -n /usr/local/bin/hivy-start-docker
fi

HIVY_SANDBOX_DATA_ROOT=/home/daytona/.hivy
HIVY_DOCKER_DATA_ROOT="${HIVY_SANDBOX_DATA_ROOT}/docker"
XDG_RUNTIME_DIR="${HIVY_SANDBOX_DATA_ROOT}/run"
DOCKER_EXEC_ROOT="${XDG_RUNTIME_DIR}/docker"
DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/docker.sock"
DOCKER_TMPDIR="${HIVY_SANDBOX_DATA_ROOT}/tmp/docker"
export HIVY_SANDBOX_DATA_ROOT HIVY_DOCKER_DATA_ROOT XDG_RUNTIME_DIR DOCKER_HOST DOCKER_TMPDIR

if ! command -v docker >/dev/null 2>&1; then
  echo "docker CLI is not installed" >&2
  exit 127
fi
if ! command -v dockerd >/dev/null 2>&1; then
  echo "dockerd is not installed" >&2
  exit 127
fi

mkdir -p \
  "${HIVY_SANDBOX_DATA_ROOT}/logs" \
  "${HIVY_DOCKER_DATA_ROOT}" \
  "${DOCKER_EXEC_ROOT}" \
  "${DOCKER_TMPDIR}"
chown root:docker "${XDG_RUNTIME_DIR}"
chmod 770 "${XDG_RUNTIME_DIR}"

if docker info >/dev/null 2>&1; then
  echo "docker already running"
  exit 0
fi

rm -f "${XDG_RUNTIME_DIR}/docker.sock" "${XDG_RUNTIME_DIR}/dockerd.pid"
rm -rf "${DOCKER_EXEC_ROOT}"
mkdir -p "${DOCKER_EXEC_ROOT}"

nohup dockerd \
  --host="${DOCKER_HOST}" \
  --data-root="${HIVY_DOCKER_DATA_ROOT}" \
  --exec-root="${DOCKER_EXEC_ROOT}" \
  --pidfile="${XDG_RUNTIME_DIR}/dockerd.pid" \
  --storage-driver=fuse-overlayfs \
  --group=docker \
  >"${HIVY_SANDBOX_DATA_ROOT}/logs/dockerd.log" 2>&1 &
dockerd_pid="$!"

for _ in $(seq 1 120); do
  if docker info >/dev/null 2>&1; then
    chown daytona:docker "${XDG_RUNTIME_DIR}/docker.sock"
    echo "docker started"
    exit 0
  fi
  if ! kill -0 "${dockerd_pid}" 2>/dev/null; then
    cat "${HIVY_SANDBOX_DATA_ROOT}/logs/dockerd.log" >&2 || true
    exit 1
  fi
  sleep 1
done

cat "${HIVY_SANDBOX_DATA_ROOT}/logs/dockerd.log" >&2 || true
exit 1
