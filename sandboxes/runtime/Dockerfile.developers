# syntax=docker/dockerfile:1.7

FROM debian:13.4

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV MISE_INSTALL_DIR=/usr/local/bin
ENV MISE_DATA_DIR=/usr/local/share/mise
ENV MISE_CONFIG_DIR=/usr/local/etc/mise
ENV MISE_CACHE_DIR=/usr/local/cache/mise
ENV PATH=/usr/local/share/mise/shims:/usr/local/go/bin:${PATH}

ARG JUST_VERSION=1.38.0
ARG RUBY_VERSION=3.3.8
ARG NODE_VERSION=lts
ARG GO_VERSION=1.25.10
ARG BUN_VERSION=latest
ARG DENO_VERSION=latest
ARG VERSION=dev
ARG COMMIT=unknown

LABEL org.opencontainers.image.source="https://github.com/usehivy/hivy"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${COMMIT}"

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    clangd \
    cmake \
    coreutils \
    curl \
    default-libmysqlclient-dev \
    dirmngr \
    direnv \
    dnsutils \
    fd-find \
    file \
    findutils \
    fish \
    g++ \
    gcc \
    gh \
    git \
    git-lfs \
    gnupg2 \
    gzip \
    iputils-ping \
    jo \
    jq \
    less \
    libgdbm-dev \
    libgmp-dev \
    libffi-dev \
    libicu-dev \
    libncurses-dev \
    libpq-dev \
    libreadline-dev \
    libssl-dev \
    libsqlite3-dev \
    libxml2-dev \
    libxslt1-dev \
    libyaml-dev \
    lsof \
    make \
    netcat-openbsd \
    openssh-client \
    openssl \
    pkg-config \
    procps \
    psmisc \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    redis-tools \
    ripgrep \
    rust-analyzer \
    rsync \
    shellcheck \
    shfmt \
    shared-mime-info \
    socat \
    sqlite3 \
    tar \
    tini \
    tmux \
    tree \
    unzip \
    vim-tiny \
    wget \
    xmlstarlet \
    xvfb \
    xz-utils \
    yq \
    zip \
    zlib1g-dev \
    zsh \
    zstd \
  && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    chromium \
    fontconfig \
    fonts-dejavu \
    fonts-liberation \
    fonts-noto \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    fonts-freefont-ttf \
    libasound2t64 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcairo-gobject2 \
    libcups2t64 \
    libdbus-1-3 \
    libdrm2 \
    libfreetype6 \
    libfontconfig1 \
    libgbm1 \
    libgdk-pixbuf-2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcb-shm0 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libxrandr2 \
    libxrender1 \
    libxshmfence1 \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    csvkit \
    exiftool \
    ffmpeg \
    ghostscript \
    graphicsmagick \
    imagemagick \
    libvips-tools \
    mediainfo \
    pandoc \
    poppler-utils \
    sox \
    tesseract-ocr \
  && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    composer \
    default-mysql-client \
    php-bcmath \
    php-cli \
    php-curl \
    php-gd \
    php-intl \
    php-mbstring \
    php-mysql \
    php-pgsql \
    php-sqlite3 \
    php-xml \
    php-zip \
    postgresql-client \
  && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    docker-cli \
    docker-compose \
    docker.io \
    fuse-overlayfs \
    iptables \
  && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/fdfind /usr/local/bin/fd \
  && git lfs install --system

RUN curl -fsSL https://mise.run | sh \
  && mv /root/.local/bin/mise /usr/local/bin/mise \
  && mise use -g just@${JUST_VERSION}

RUN mise use -g node@${NODE_VERSION} \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000 \
  && npm install -g \
    markdownlint-cli \
    mongosh \
    bash-language-server \
    dockerfile-language-server-nodejs \
    @tailwindcss/language-server \
    pnpm@10 \
    pyright \
    prettier \
    typescript \
    typescript-language-server \
    vscode-langservers-extracted \
    yaml-language-server \
    yarn@1.22.22 \
  && npm cache clean --force

RUN mise use -g go@${GO_VERSION} \
  && GOBIN=/usr/local/bin go install golang.org/x/tools/gopls@latest

RUN mise use -g bun@${BUN_VERSION}

RUN mise use -g deno@${DENO_VERSION}

RUN npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000 \
  && npm install -g --prefix=/usr/local agent-browser \
  && ln -sf /usr/local/bin/agent-browser /usr/local/bin/browser \
  && mkdir -p /workspace \
  && HOME=/workspace agent-browser install \
  && npm cache clean --force

RUN python3 -m pip install --break-system-packages --no-cache-dir \
    beautifulsoup4 \
    black \
    fpdf2 \
    httpie \
    lxml \
    openpyxl \
    pillow \
    pypdf \
    pytest \
    python-docx \
    python-pptx \
    reportlab \
    requests \
    ruff \
    uv

RUN mise settings set ruby.compile false \
  && MISE_RUBY_COMPILE=false mise use -g ruby@${RUBY_VERSION} \
  && ruby -v \
  && gem -v \
  && bundle -v

RUN printf '%s\n' 'if [ -n "${BASH_VERSION:-}" ]; then' '  eval "$(mise activate bash)"' 'fi' >/etc/profile.d/mise.sh

WORKDIR /app

COPY hivy-sandboxes-runtime /usr/local/bin/hivy-sandboxes-runtime
COPY penpot /usr/local/bin/penpot
COPY docker/runtime/entrypoint /usr/local/bin/hivy-runtime-entrypoint
COPY docker/runtime/hivy-start-docker /usr/local/bin/hivy-start-docker
COPY docker/runtime/git-credential-hivy /usr/local/bin/git-credential-hivy
COPY docker/runtime/gh-wrapper /usr/local/bin/gh-wrapper
COPY scripts/hivy-guardian.sh /usr/local/bin/hivy-guardian

RUN chmod +x /usr/local/bin/hivy-sandboxes-runtime \
  && chmod +x /usr/local/bin/penpot \
  && ln -sf /usr/local/bin/penpot /usr/local/bin/canvas \
  && mkdir -p /app/data /workspace/.hivy/tmp/docker /workspace/.hivy/docker /var/lib/docker /var/run \
  && chmod +x /usr/local/bin/hivy-runtime-entrypoint \
  && chmod +x /usr/local/bin/hivy-start-docker \
  && chmod +x /usr/local/bin/git-credential-hivy \
  && chmod +x /usr/local/bin/gh-wrapper \
  && chmod +x /usr/local/bin/hivy-guardian \
  && git config --system credential.helper /usr/local/bin/git-credential-hivy \
  && ln -sf /usr/local/bin/gh-wrapper /usr/local/bin/gh

ENV HOME=/workspace
ENV HIVY_SANDBOX_DATA_ROOT=/workspace/.hivy
ENV HIVY_DOCKER_DATA_ROOT=/workspace/.hivy/docker
ENV TMPDIR=/workspace/.hivy/tmp
ENV TEMP=/workspace/.hivy/tmp
ENV TMP=/workspace/.hivy/tmp
ENV DOCKER_TMPDIR=/workspace/.hivy/tmp/docker
ENV HIVY_DB_PATH=/workspace/.hivy/runtime/hivy-sandboxes-runtime.db
ENV HIVY_WORKSPACE_ROOT=/workspace
ENV HIVY_RUNTIME_BIND_ADDR=0.0.0.0:7080
ENV HIVY_SANDBOXES_RUNTIME_VERSION=${VERSION}
ENV HIVY_SANDBOXES_RUNTIME_COMMIT=${COMMIT}
ENV NO_BROWSER=1
ENV DOCKER_HOST=unix:///var/run/docker.sock
ENV DOCKER_BUILDKIT=1
ENV COMPOSE_DOCKER_CLI_BUILD=1

EXPOSE 7080

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hivy-runtime-entrypoint", "/usr/local/bin/hivy-sandboxes-runtime"]
