# syntax=docker/dockerfile:1.7

FROM debian:13.4

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV MISE_INSTALL_DIR=/usr/local/bin
ENV MISE_DATA_DIR=/usr/local/share/mise
ENV MISE_CONFIG_DIR=/usr/local/etc/mise
ENV MISE_CACHE_DIR=/usr/local/cache/mise
ENV PATH=/usr/local/share/mise/shims:/usr/local/go/bin:${PATH}

ARG JUST_VERSION=1.38.0
ARG RUBY_VERSION=3.3.8
ARG NODE_VERSION=lts
ARG GO_VERSION=1.25.10
ARG BUN_VERSION=latest
ARG DENO_VERSION=latest
ARG VERSION=dev
ARG COMMIT=unknown

LABEL org.opencontainers.image.source="https://github.com/usehivy/hivy"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${COMMIT}"

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    chromium \
    cmake \
    composer \
    coreutils \
    curl \
    csvkit \
    default-libmysqlclient-dev \
    default-mysql-client \
    dirmngr \
    direnv \
    dnsutils \
    docker-cli \
    docker-compose \
    docker.io \
    exiftool \
    fd-find \
    ffmpeg \
    file \
    findutils \
    firefox-esr \
    fish \
    fontconfig \
    fonts-dejavu \
    fonts-liberation \
    fonts-noto \
    fonts-noto-color-emoji \
    g++ \
    gcc \
    gh \
    ghostscript \
    git \
    git-lfs \
    gnupg2 \
    graphicsmagick \
    gzip \
    fuse-overlayfs \
    imagemagick \
    iptables \
    iputils-ping \
    jo \
    jq \
    less \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libgbm1 \
    libgdbm-dev \
    libgmp-dev \
    libgtk-3-0 \
    libffi-dev \
    libicu-dev \
    libncurses-dev \
    libnss3 \
    libpq-dev \
    libreadline-dev \
    libssl-dev \
    libsqlite3-dev \
    libvips-tools \
    libxml2-dev \
    libxslt1-dev \
    libyaml-dev \
    lsof \
    make \
    mediainfo \
    netcat-openbsd \
    openssh-client \
    openssl \
    pandoc \
    php-bcmath \
    php-cli \
    php-curl \
    php-gd \
    php-intl \
    php-mbstring \
    php-mysql \
    php-pgsql \
    php-sqlite3 \
    php-xml \
    php-zip \
    pkg-config \
    poppler-utils \
    postgresql-client \
    procps \
    psmisc \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    redis-tools \
    ripgrep \
    rsync \
    shellcheck \
    shfmt \
    shared-mime-info \
    socat \
    sox \
    sqlite3 \
    tar \
    tesseract-ocr \
    tini \
    tmux \
    tree \
    unzip \
    vim-tiny \
    wget \
    xmlstarlet \
    xvfb \
    xz-utils \
    yq \
    zip \
    zlib1g-dev \
    zsh \
    zstd \
  && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/fdfind /usr/local/bin/fd \
  && git lfs install --system

RUN curl -fsSL https://mise.run | sh \
  && mv /root/.local/bin/mise /usr/local/bin/mise \
  && mise use -g just@${JUST_VERSION}

RUN mise use -g node@${NODE_VERSION} \
  && mise use -g go@${GO_VERSION} \
  && mise use -g bun@${BUN_VERSION} \
  && mise use -g deno@${DENO_VERSION} \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000 \
  && npm install -g \
    markdownlint-cli \
    mongosh \
    pnpm@10 \
    prettier \
    yarn@1.22.22 \
  && npm cache clean --force

RUN python3 -m pip install --break-system-packages --no-cache-dir \
    beautifulsoup4 \
    black \
    fpdf2 \
    httpie \
    lxml \
    openpyxl \
    pillow \
    pypdf \
    pytest \
    python-docx \
    python-pptx \
    reportlab \
    requests \
    ruff \
    uv

RUN mise settings set ruby.compile false \
  && MISE_RUBY_COMPILE=false mise use -g ruby@${RUBY_VERSION} \
  && ruby -v \
  && gem -v \
  && bundle -v

RUN printf '%s\n' 'if [ -n "${BASH_VERSION:-}" ]; then' '  eval "$(mise activate bash)"' 'fi' >/etc/profile.d/mise.sh

WORKDIR /app

COPY hivy-sandboxes-runtime /usr/local/bin/hivy-sandboxes-runtime
COPY docker/runtime/entrypoint /usr/local/bin/hivy-runtime-entrypoint
COPY docker/runtime/git-credential-hivy /usr/local/bin/git-credential-hivy
COPY docker/runtime/gh-wrapper /usr/local/bin/gh-wrapper
COPY scripts/hivy-guardian.sh /usr/local/bin/hivy-guardian

RUN chmod +x /usr/local/bin/hivy-sandboxes-runtime \
  && mkdir -p /app/data /workspace /var/lib/docker /var/run \
  && chmod +x /usr/local/bin/hivy-runtime-entrypoint \
  && chmod +x /usr/local/bin/git-credential-hivy \
  && chmod +x /usr/local/bin/gh-wrapper \
  && chmod +x /usr/local/bin/hivy-guardian \
  && git config --system credential.helper /usr/local/bin/git-credential-hivy \
  && ln -sf /usr/local/bin/gh-wrapper /usr/local/bin/gh

ENV HOME=/workspace
ENV HIVY_DB_PATH=/app/data/hivy-sandboxes-runtime.db
ENV HIVY_WORKSPACE_ROOT=/workspace
ENV HIVY_RUNTIME_BIND_ADDR=0.0.0.0:7080
ENV HIVY_SANDBOXES_RUNTIME_VERSION=${VERSION}
ENV HIVY_SANDBOXES_RUNTIME_COMMIT=${COMMIT}
ENV NO_BROWSER=1
ENV DOCKER_HOST=unix:///var/run/docker.sock
ENV DOCKER_BUILDKIT=1
ENV COMPOSE_DOCKER_CLI_BUILD=1

EXPOSE 7080

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hivy-runtime-entrypoint", "/usr/local/bin/hivy-sandboxes-runtime"]
