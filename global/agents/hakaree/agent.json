{
  "version": 1,
  "slug": "hakaree",
  "name": "Hakaree",
  "description": "Coding, devops, infrastructure and debugging specialist.",
  "category": "Developer Tools",
  "avatar_url": "/assets/hakaree.png",
  "developer": "Hivy",
  "official": true,
  "agent_version": "1",
  "enabled": true,
  "default": true,
  "runtime": {
    "sandbox_strategy": "per_session",
    "sandbox_image": "developer",
    "model": "deepseek-v4-pro",
    "available_models": [
      "deepseek-v4-pro",
      "crof-deepseek-v4-pro",
      "crof-deepseek-v4-flash",
      "qwen3.7-plus",
      "glm-5.1",
      "glm-5.2",
      "crof-glm-5.2",
      "kimi-k2.6",
      "kimi-k2.7-code",
      "crof-kimi-k2.7-code",
      "minimax-m3",
      "mimo-v2.5-pro",
      "crof-mimo-v2.5-pro"
    ],
    "multimodal_model": "gemini-3-flash-preview"
  },
  "prompt": {
    "instructions": "./prompts/instructions.md"
  },
  "tools": {
    "bash": true,
    "read_file": true,
    "write_file": true,
    "file_search": true,
    "glob": true,
    "grep": true,
    "multi_grep": true,
    "apply_patch": true,
    "lsp": true,
    "check_bash_status": true,
    "search_sessions": true,
    "update_plan": true,
    "skills_list": true,
    "skill_view": true,
    "skill_manage": true,
    "subagent_task": true,
    "check_subagent_task_status": true,
    "request_user_input": true
  },
  "sub_agents": {
    "codebase-explorer": {
      "name": "Codebase Explorer",
      "description": "Contextual codebase search specialist. Finds where code lives, which files contain a behavior, how implementation flows across modules, and what tests or call sites define the blast radius. Use for unfamiliar module structure, broad pattern discovery, and questions like \"Where is X implemented?\" or \"Find the code that does Z.\"",
      "model": "deepseek-v4-flash",
      "tools": {
        "read_file": true,
        "file_search": true,
        "glob": true,
        "grep": true,
        "multi_grep": true,
        "lsp": true,
        "search_sessions": true,
        "update_plan": true,
        "skills_list": true,
        "skill_view": true
      },
      "prompt": {
        "instructions": "./sub_agents/codebase-explorer/instructions.md"
      }
    },
    "librarian": {
      "name": "Librarian",
      "description": "External open-source codebase and documentation researcher. Investigates unfamiliar libraries, dependency behavior, upstream APIs, release history, and real-world implementation examples. Use when the answer depends on source outside the local working tree or needs primary-source citations.",
      "model": "deepseek-v4-flash",
      "tools": {
        "bash": true,
        "check_bash_status": true,
        "read_file": true,
        "file_search": true,
        "glob": true,
        "grep": true,
        "multi_grep": true,
        "search_sessions": true,
        "update_plan": true,
        "skills_list": true,
        "skill_view": true
      },
      "prompt": {
        "instructions": "./sub_agents/librarian/instructions.md"
      }
    },
    "oracle": {
      "name": "Oracle",
      "description": "Read-only strategic technical advisor for hard architecture, debugging, security, performance, concurrency, and multi-system tradeoffs. Use after significant implementation, after repeated failed fixes, or when a design choice needs senior-level scrutiny.",
      "model": "deepseek-v4-pro",
      "tools": {
        "read_file": true,
        "file_search": true,
        "glob": true,
        "grep": true,
        "multi_grep": true,
        "lsp": true,
        "search_sessions": true,
        "skills_list": true,
        "skill_view": true
      },
      "prompt": {
        "instructions": "./sub_agents/oracle/instructions.md"
      }
    }
  },
  "plugins": {
    "required": ["github"],
    "recommended": []
  }
}
