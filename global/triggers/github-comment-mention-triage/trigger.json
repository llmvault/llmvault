{
  "version": 1,
  "slug": "github-comment-mention-triage",
  "name": "GitHub Comment Mention Triage",
  "description": "Triage GitHub comments mentioning Hivy.",
  "category": "Engineering",
  "enabled": true,
  "official": true,
  "integration": {
    "provider": "github-app",
    "required": true
  },
  "plugins": {
    "required": ["github"],
    "recommended": []
  },
  "trigger": {
    "type": "webhook",
    "keys": ["issue_comment.created"],
    "conditions": {
      "mode": "any",
      "conditions": [
        {
          "path": "comment.body",
          "operator": "matches",
          "value": "(?i)(@?hivy|hey hivy|hivy,|hivy:)"
        }
      ]
    }
  },
  "install": {
    "default_agent": "hivy",
    "enabled": true,
    "instructions": "./instructions.md"
  }
}
