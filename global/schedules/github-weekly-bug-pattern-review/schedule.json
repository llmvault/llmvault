{
  "version": 1,
  "slug": "github-weekly-bug-pattern-review",
  "name": "GitHub Weekly Bug Pattern Review",
  "description": "Group recurring GitHub bug patterns.",
  "category": "Product",
  "enabled": true,
  "official": true,
  "integration": {
    "provider": "github-app",
    "required": true
  },
  "connections": {
    "required": ["github"],
    "recommended": []
  },
  "schedule": {
    "kind": "cron",
    "cron": "0 11 * * 2",
    "timezone": "workspace",
    "suggested_time_label": "Tuesdays at 11:00 AM"
  },
  "resources": {
    "supported": ["github_repo"],
    "selection": "optional"
  },
  "limits": {
    "lookback_hours": 168,
    "max_items": 50
  },
  "install": {
    "default_agent": "hivy",
    "default_channel": "workspace",
    "enabled": true,
    "instructions": "./instructions.md"
  }
}
