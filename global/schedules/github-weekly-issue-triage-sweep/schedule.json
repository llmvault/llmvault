{
  "version": 1,
  "slug": "github-weekly-issue-triage-sweep",
  "name": "GitHub Weekly Issue Triage Sweep",
  "description": "Review stale and untriaged issues.",
  "category": "Engineering",
  "enabled": true,
  "official": true,
  "integration": {
    "provider": "github-app",
    "required": true
  },
  "connections": {
    "required": ["github"],
    "recommended": []
  },
  "schedule": {
    "kind": "cron",
    "cron": "0 10 * * 1",
    "timezone": "workspace",
    "suggested_time_label": "Mondays at 10:00 AM"
  },
  "resources": {
    "supported": ["github_repo"],
    "selection": "optional"
  },
  "limits": {
    "lookback_hours": 168,
    "max_items": 40
  },
  "install": {
    "default_agent": "hivy",
    "default_channel": "workspace",
    "enabled": true,
    "instructions": "./instructions.md"
  }
}
