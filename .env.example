# =============================================================================
# Hivy local development environment
# =============================================================================
# Copy this file to `.env`, then run `make up`.
# Docker Compose is the source of truth for local development.

# =============================================================================
# 1. Docker Compose host ports and images
# =============================================================================
HIVY_COMPOSE_API_PORT=8080
HIVY_COMPOSE_PROXY_PORT=18082
HIVY_COMPOSE_MCP_PORT=8081
HIVY_COMPOSE_WEB_PORT=30112
HIVY_COMPOSE_WORKER_HEALTH_PORT=8090
HIVY_COMPOSE_POSTGRES_PORT=15432
HIVY_COMPOSE_REDIS_PORT=16379
HIVY_COMPOSE_NANGO_PORT=23003
HIVY_COMPOSE_QDRANT_HTTP_PORT=6333
HIVY_COMPOSE_QDRANT_GRPC_PORT=6334
HIVY_COMPOSE_MINIO_API_PORT=9000
HIVY_COMPOSE_MINIO_CONSOLE_PORT=9001

# =============================================================================
# 2. Hivy backend process: runtime, HTTP, auth, and admin
# =============================================================================
HIVY_ENVIRONMENT=development
HIVY_PORT=8080
HIVY_LOG_LEVEL=info
HIVY_LOG_FORMAT=text
HIVY_FRONTEND_URL=http://localhost:30112
HIVY_CORS_ORIGINS=http://localhost:30112
HIVY_MCP_PORT=8081
HIVY_MCP_BASE_URL=
HIVY_API_WEBHOOK_BASE_URL=
HIVY_PROXY_HOST=
HIVY_AUTO_CONFIRM_EMAIL=true
HIVY_ADMIN_ENABLED=false
HIVY_ADMIN_SECRET=

HIVY_SESSION_SECRET=local-dev-session-secret-change-me
HIVY_JWT_SIGNING_KEY=local-dev-jwt-signing-key-change-me
HIVY_AUTH_RSA_PRIVATE_
HIVY_AUTH_ISSUER=hivy
HIVY_AUTH_AUDIENCE=http://localhost:8080
HIVY_AUTH_ACCESS_TOKEN_TTL=15m
HIVY_AUTH_REFRESH_TOKEN_TTL=720h

HIVY_KMS_TYPE=aead
HIVY_KMS_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
HIVY_AWS_REGION=

# =============================================================================
# 3. Hivy backend process: database, Redis, cache, and worker tuning
# =============================================================================
HIVY_DATABASE_URL=postgres://hivy:localdev@postgres:5432/hivy?sslmode=disable
HIVY_DB_HOST=postgres
HIVY_DB_PORT=5432
HIVY_DB_USER=hivy
HIVY_DB_PASSWORD=localdev
HIVY_DB_NAME=hivy
HIVY_DB_SSLMODE=disable
HIVY_POSTGRES_MAX_LOCKS_PER_TRANSACTION=256

HIVY_REDIS_URL=
HIVY_REDIS_ADDR=redis:6379
# Set HIVY_REDIS_CLUSTER=true to discover a cluster from HIVY_REDIS_ADDR or URL.
# Optionally provide several comma-separated seed nodes for resilience.
HIVY_REDIS_CLUSTER=false
HIVY_REDIS_CLUSTER_ADDRS=
HIVY_REDIS_PASSWORD=
HIVY_REDIS_DB=0
HIVY_REDIS_CACHE_TTL=30m
HIVY_MEM_CACHE_TTL=5m
HIVY_MEM_CACHE_MAX_SIZE=10000

HIVY_RUNTIME_REDIS_STREAM_SHARD_COUNT=64

HIVY_ASYNQ_CONCURRENCY=30
HIVY_SANDBOX_SLEEP_CONCURRENCY=100
HIVY_ASYNQ_SHUTDOWN_TIMEOUT=120s
HIVY_WORKER_HEALTH_PORT=8090

# =============================================================================
# 4. Nango service and Hivy integration catalog credentials
# =============================================================================
# Hivy uses HIVY_NANGO_ENDPOINT / HIVY_NANGO_SECRET_KEY to call Nango.
# HIVY_NANGO_WEBHOOKS_SECRET verifies inbound webhook signatures from Nango.
# The Nango container consumes the other HIVY_NANGO_* values through Compose.
# Make targets generate tmp/nango-compose.env to select a native real-Nango
# image on arm64 Docker hosts. Override these only when testing another image.
HIVY_NANGO_IMAGE=
HIVY_NANGO_PLATFORM=
HIVY_NANGO_ENDPOINT=http://nango:3003
HIVY_NANGO_PUBLIC_URL=http://localhost:23003
HIVY_NANGO_SECRET_KEY=00000000-0000-4000-8000-000000000001
HIVY_NANGO_WEBHOOKS_SECRET=00000000-0000-4000-8000-000000000001
HIVY_NANGO_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
HIVY_NANGO_DASHBOARD_USERNAME=local
HIVY_NANGO_DASHBOARD_PASSWORD=local

# =============================================================================
# 5. Sandbox orchestration: generic settings and provider selection
# =============================================================================
HIVY_SANDBOX_PROVIDER_ID=docker
HIVY_SANDBOX_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
HIVY_SANDBOX_RESOURCE_CHECK_INTERVAL=30m
HIVY_SANDBOX_IDLE_TIMEOUT=5m
HIVY_AGENT_SCHEDULE_SCAN_INTERVAL=5s
HIVY_PREVIEW_ACTIVITY_TOKEN=
# Required. Wildcard preview host suffix ({port}-{sandbox_id}.<domain>) for
# user-facing sandbox previews. The server fails to start if this is unset.
HIVY_PREVIEW_BASE_DOMAIN=preview.usehivy.com

HIVY_SANDBOXES_RUNTIME_IMAGE_TAG=runtime

# Docker sandbox provider. Required when HIVY_SANDBOX_PROVIDER_ID=docker.
HIVY_SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
# Browser-facing runtime origin. Local Compose keeps this on localhost.
HIVY_SANDBOX_DOCKER_RUNTIME_ORIGIN=http://127.0.0.1
# Server-side origin used by API/worker containers to reach published sandbox ports.
HIVY_SANDBOX_DOCKER_CONTROL_ORIGIN=http://host.docker.internal
HIVY_SANDBOX_DOCKER_CONTAINER_LABEL_PREFIX=hivy

# Daytona sandbox provider. Required only when HIVY_SANDBOX_PROVIDER_ID=daytona.
HIVY_DAYTONA_API_URL=
HIVY_DAYTONA_API_KEY=
HIVY_DAYTONA_TARGET=
HIVY_DAYTONA_MAX_CPU=4
HIVY_DAYTONA_MAX_MEMORY_GB=8
HIVY_DAYTONA_MAX_DISK_GB=10

# Railway sandbox provider. Required only when HIVY_SANDBOX_PROVIDER_ID=railway.
HIVY_RAILWAY_API_TOKEN=
HIVY_RAILWAY_PROJECT_ID=
HIVY_RAILWAY_ENVIRONMENT_ID=
HIVY_RAILWAY_REGION=
HIVY_RAILWAY_RUNTIME_PORT=7080

# Microsandbox sandbox provider. Required only when HIVY_SANDBOX_PROVIDER_ID=microsandbox.
HIVY_MICROSANDBOX_CONTROL_URL=
HIVY_MICROSANDBOX_CONTROL_API_TOKEN=
HIVY_SANDBOX_WARM_POOL_DEFAULT_SIZE=0
HIVY_SANDBOX_WARM_POOL_DEVELOPER_SIZE=0

# =============================================================================
# 6. Hivy storage: drive and uploads
# =============================================================================
HIVY_AWS_S3_BUCKET_NAME=hivy-rag-test
HIVY_AWS_DEFAULT_REGION=us-east-1
HIVY_AWS_ENDPOINT_URL=http://minio:9000
HIVY_AWS_PRESIGN_ENDPOINT_URL=http://host.docker.internal:9000
HIVY_AWS_ACCESS_KEY_ID=minioadmin
HIVY_AWS_SECRET_ACCESS_KEY=minioadmin

# =============================================================================
# 7. Hivy RAG and search configuration
# =============================================================================
HIVY_QDRANT_HOST=qdrant
HIVY_QDRANT_PORT=6334
HIVY_QDRANT_USE_TLS=false
HIVY_QDRANT_API_KEY=
HIVY_QDRANT_COLLECTION=rag_chunks_3072
HIVY_RAG_BATCH_SIZE=100

HIVY_LLM_API_URL=
HIVY_LLM_API_KEY=
HIVY_LLM_MODEL=
HIVY_LLM_EMBEDDING_DIM=3072

HIVY_MEMORY_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
HIVY_MEMORY_EMBEDDING_DIM=1024

HIVY_RERANKER_BASE_URL=
HIVY_RERANKER_API_KEY=
HIVY_RERANKER_MODEL=

# =============================================================================
# 8. Web app runtime and browser-exposed values
# =============================================================================
HIVY_API_URL=http://api:8080
NEXT_PUBLIC_HIVY_API_URL=http://localhost:8080
NEXT_PUBLIC_HIVY_CONNECTIONS_HOST=http://localhost:23003

# Optional in-product documentation and YouTube tutorial links.
HIVY_DOCS_URL=
HIVY_WELCOME_VIDEO_URL=
HIVY_TUTORIAL_AUTOMATIONS_VIDEO_URL=
HIVY_TUTORIAL_SCHEDULES_VIDEO_URL=
HIVY_TUTORIAL_WEBHOOKS_VIDEO_URL=
HIVY_TUTORIAL_PLUGINS_VIDEO_URL=
HIVY_TUTORIAL_KNOWLEDGE_VIDEO_URL=
HIVY_TUTORIAL_TEAMS_VIDEO_URL=
NEXT_PUBLIC_HIVY_ADMIN_ENABLED=false

# =============================================================================
# 10. Observability
# =============================================================================
HIVY_SENTRY_ENABLED=false
HIVY_SENTRY_DSN=
NEXT_PUBLIC_HIVY_SENTRY_DSN=
HIVY_SENTRY_RELEASE=
HIVY_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_HIVY_SENTRY_TRACES_SAMPLE_RATE=0
HIVY_SENTRY_PROFILES_SAMPLE_RATE=0
HIVY_AGENT_SANDBOX_SENTRY_DSN=

# =============================================================================
# 11. Optional Hivy product integrations
# =============================================================================
# Email (SMTP). Leave HIVY_SMTP_HOST empty in dev — emails are rendered and
# written to a temp file (path logged) instead of sent. Point at any SMTP
# provider (Resend SMTP, SES, Postmark, self-hosted) to actually deliver.
HIVY_SMTP_HOST=
HIVY_SMTP_PORT=587
HIVY_SMTP_USERNAME=
HIVY_SMTP_PASSWORD=
HIVY_SMTP_TLS=starttls
HIVY_EMAIL_FROM=
HIVY_EMAIL_SITE_URL=
HIVY_EMAIL_ASSET_URL=

# Agent email inboxes (Resend Receiving). These are intentionally separate
# from SMTP: Resend's inbound API retrieves email bodies and headers.
HIVY_RESEND_API_KEY=
HIVY_RESEND_WEBHOOK_SECRET=
HIVY_AGENT_INBOX_DOMAIN=

HIVY_OAUTH_GITHUB_CLIENT_ID=
HIVY_OAUTH_GITHUB_CLIENT_SECRET=
HIVY_OAUTH_GOOGLE_CLIENT_ID=
HIVY_OAUTH_GOOGLE_CLIENT_SECRET=
HIVY_OAUTH_X_CLIENT_ID=
HIVY_OAUTH_X_CLIENT_SECRET=

HIVY_GITHUB_TOKEN=
HIVY_SPIDER_CLOUD_API_KEY=
HIVY_FIRECRAWL_API_KEY=
HIVY_SERPER_API_KEY=
HIVY_PAYSTACK_SECRET_KEY=
HIVY_BILLING_NGN_MINOR_PER_USD=160000

# =============================================================================
# 12. Optional custom preview domains
# =============================================================================
HIVY_ACME_DNS_API_URL=
HIVY_CADDY_ADMIN_URL=

# =============================================================================
# 13. Local/E2E model-provider credentials (never deploy live)
# =============================================================================
HIVY_SYSTEM_OPENAI_API_KEY=
HIVY_SYSTEM_ANTHROPIC_API_KEY=
HIVY_SYSTEM_GOOGLE_API_KEY=
HIVY_SYSTEM_OPENROUTER_API_KEY=
HIVY_SYSTEM_REVE_API_KEY=
HIVY_SYSTEM_MOONSHOT_API_KEY=
