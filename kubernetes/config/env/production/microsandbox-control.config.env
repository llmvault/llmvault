HIVY_MICROSANDBOX_ADDR=:8080
HIVY_MICROSANDBOX_ENVIRONMENT=production
HIVY_MICROSANDBOX_LOG_FORMAT=json
HIVY_MICROSANDBOX_LOG_LEVEL=info
