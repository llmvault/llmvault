          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(sessions_24h),0) FROM observability_org_support WHERE ('$org_id' = '' OR org_id::text = '$org_id')",
          "refId": "A"
