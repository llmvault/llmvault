          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT * FROM observability_session_support WHERE ('$org_id' = '' OR org_id::text = '$org_id') AND ('$session_id' = '' OR session_id::text = '$session_id') ORDER BY created_at DESC LIMIT 200",
