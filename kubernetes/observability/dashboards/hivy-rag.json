        "type": "custom",
        "query": "production,staging",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "selected": true,
            "text": "production",
            "value": "production"
          },
          {
            "selected": false,
            "text": "staging",
            "value": "staging"
          }
        ]
      },
      {
        "name": "support_datasource",
        "label": "Support database",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "regex": "/Hivy Support - $environment/i",
        "current": {
          "text": "Hivy Support - Production",
          "value": "hivy-support-production"
        },
        "refresh": 1
      },
      {
        "name": "org_id",
        "label": "Org ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
