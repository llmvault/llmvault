          "rawQuery": true,
          "rawSql": "SELECT bucket, tool_name, status, call_count, error_count, avg_total_ms, credits_used FROM observability_tool_hourly WHERE $__timeFilter(bucket) AND ('$org_id' = '' OR org_id::text = '$org_id') ORDER BY bucket DESC, error_count DESC LIMIT 500",
          "refId": "A"
        }
      ]
