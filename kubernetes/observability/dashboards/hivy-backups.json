      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(kube_cronjob_spec_suspend{namespace=\"$environment\",cronjob=~\".*backup.*\"})",
