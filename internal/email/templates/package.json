{
  "name": "@usehivy/email-templates",
  "private": true,
  "type": "module",
  "description": "React Email sources for Hivy transactional emails. Rendered to static HTML/text with {{{placeholder}}} tokens that the Go backend substitutes at send time.",
  "scripts": {
    "dev": "email dev --dir emails --port 30113",
    "build": "tsx scripts/build-templates.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
