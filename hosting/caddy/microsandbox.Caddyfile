{
	email {$ACME_EMAIL}
}

{$CONTROL_DOMAIN} {
	reverse_proxy control:8080

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

*.{$PREVIEW_BASE_DOMAIN} {
	reverse_proxy control:8080 {
		transport http {
			response_header_timeout 600s
			dial_timeout 10s
		}
		flush_interval -1
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
