{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Hivy desktop window permissions",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*/*", "http://127.0.0.1:*/*", "https://*/*"]
  },
  "permissions": [
    "core:default",
    "allow-desktop-cloud-url",
    "allow-desktop-info",
    "allow-runtime-request",
    "allow-runtime-session-stream"
  ]
}
