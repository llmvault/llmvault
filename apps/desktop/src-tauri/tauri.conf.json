{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hivy",
  "version": "0.0.1",
  "identifier": "com.usehivy.desktop",
  "build": {
    "beforeDevCommand": "pnpm prepare:runtime",
    "beforeBuildCommand": "pnpm prepare:runtime:release",
    "devUrl": "http://localhost:30112/w?desktop=1",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hivy",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/hivy-sandboxes-runtime"]
  }
}
